{
	admin 127.0.0.1:2019
	http_port 18080
	https_port 18443
	# TLS 握手失败只在 debug 级别记录（logger=http.stdlib）。
	# 2026-11-07 临时开启以取证「4090 连不上」；演示后（2026-11-11 起）可移除本行。
	debug
	servers {
		protocols h1 h2
	}
}

aicentre2.sligenai.cn {
	tls /home/donxu/ai-centre/runtime/acme-home/aicentre2.sligenai.cn_ecc/fullchain.cer /home/donxu/ai-centre/runtime/acme-home/aicentre2.sligenai.cn_ecc/aicentre2.sligenai.cn.key

	@site_root path /
	handle @site_root {
		redir * /admin/ 308
	}

	@public_api_docs path /api-docs.md
	handle @public_api_docs {
		header Content-Type "text/markdown; charset=utf-8"
		root * /home/donxu/ai-centre/docs
		file_server
	}

	@admin_ui path /admin /admin/*
	handle @admin_ui {
		reverse_proxy 127.0.0.1:8340 {
			transport http {
				dial_timeout 10s
				response_header_timeout 1800s
			}
		}
	}

	@admin_api path /v1/admin/*
	handle @admin_api {
		respond 404
	}

	@internal_api path /internal/*
	handle @internal_api {
		respond 404
	}

	@internal_uploads path /v1/lipsync/jobs/upload /v1/asr/transcriptions/upload /v2/tts/speech/upload /v1/tts/speech
	handle @internal_uploads {
		respond 404
	}

	@tts_stream path /v2/tts/speech/stream
	handle @tts_stream {
		reverse_proxy 127.0.0.1:8320 {
			flush_interval -1
			transport http {
				dial_timeout 10s
				response_header_timeout 1800s
			}
		}
	}

	# libtv 代理：上游 chorify3.sligenai.cn/libtv 没有 CORS，且 publish 会花积分，
	# 所以由 127.0.0.1:8399 这层做反向代理 + X-Libtv-Token 校验。
	handle_path /libtv-api/* {
		reverse_proxy 127.0.0.1:8399
	}

	# 抖音采集服务在 http://121.43.51.197（纯 HTTP），本站在 https 下必须走这层转发，
	# 否则浏览器按混合内容拦掉；token 由代理在服务端注入。
	handle_path /douyin-api/* {
		reverse_proxy 127.0.0.1:8398
	}

	@jmapi_admin path /jmapi-admin /jmapi-admin/*
	handle @jmapi_admin {
		root * /home/donxu/ai-centre/runtime
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8320 {
			transport http {
				dial_timeout 10s
				response_header_timeout 1800s
			}
		}
	}

	log {
		output file /home/donxu/ai-centre/runtime/caddy/logs/access.log {
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 720h
		}
	}
}

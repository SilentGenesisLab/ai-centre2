+                text_token_count -= 1
+            text_token_count = max(1, text_token_count)
+            official_cap = text_token_count * 6 + 10
+            cap_candidates = [official_cap]
+            configured_cap = getattr(stage0_params, "max_tokens", None)
+            if configured_cap is not None:
+                cap_candidates.append(int(configured_cap))
+            if request.max_new_tokens is not None:
+                cap_candidates.append(int(request.max_new_tokens))
+            stage0_params.max_tokens = max(4, min(cap_candidates))
+
+            # Model preprocess receives prompt additional_information, not the
+            # SamplingParams object.  Copy the caller seed there so CFM noise
+            # and the AR sampler use the same request-level seed.
+            if request.seed is not None and isinstance(prompt, dict):

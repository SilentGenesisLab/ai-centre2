[Unit]
Description=AI Centre Face Mosaic Celery Worker GPU 1
After=network-online.target

[Service]
Type=simple
UMask=0007
WorkingDirectory=/home/donxu/ai-centre
Environment=PYTHONPATH=/home/donxu/ai-centre
Environment=AI_CENTRE_TEMP_DATA_ROOT=/home/donxu/temp-data
Environment=AI_CENTRE_TEMP_DATA_TIMEZONE=Asia/Shanghai
Environment=AI_CENTRE_TEMP_FAILURE_RETENTION_SECONDS=86400
EnvironmentFile=/home/donxu/ai-centre/.env
Environment=CUDA_VISIBLE_DEVICES=1
ExecStart=/home/donxu/ai-centre/.venv/bin/celery -A face_worker.celery_app:celery_app worker -Q face_mosaic -n face-gpu1@%%h --concurrency=1 --loglevel=INFO
Restart=always
RestartSec=3
TimeoutStopSec=1800
KillSignal=SIGTERM

[Install]
WantedBy=default.target

[Unit]
Description=AI Centre VoxCPM2 legacy compatibility gateway
After=network-online.target ai-centre-voxcpm2-gpu1.service
Wants=network-online.target ai-centre-voxcpm2-gpu1.service

[Service]
Type=simple
UMask=0007
WorkingDirectory=/home/donxu/ai-centre
Environment=PYTHONPATH=/home/donxu/ai-centre
Environment=AI_CENTRE_TEMP_DATA_ROOT=/home/donxu/temp-data
Environment=AI_CENTRE_TEMP_DATA_TIMEZONE=Asia/Shanghai
Environment=AI_CENTRE_TEMP_FAILURE_RETENTION_SECONDS=86400
Environment=VOXCPM2_OPENAI_URL=http://127.0.0.1:8192
Environment=VOXCPM2_ALLOWED_MEDIA_ROOTS=/home/donxu/temp-data,/home/donxu/ai-centre/runtime/references
Environment=VOXCPM2_REQUEST_TIMEOUT_SECONDS=900
Environment=VOXCPM2_ENABLE_VOICE_CLONING=true
ExecStart=/home/donxu/ai-centre/.venv-control/bin/uvicorn managed_backends.voxcpm2_compat_api:app --host 127.0.0.1 --port 8193
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=65536
TasksMax=512

[Install]
WantedBy=default.target

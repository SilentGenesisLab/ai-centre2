[Unit]
Description=AI Centre 2 video upscale Celery worker
After=network-online.target ai-centre-control.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/donxu/ai-centre
EnvironmentFile=/home/donxu/ai-centre/.env
Environment=PYTHONPATH=/home/donxu/ai-centre
Environment=CUDA_VISIBLE_DEVICES=
ExecStart=/home/donxu/ai-centre/.venv-control/bin/celery -A control_plane.celery_app:celery_app worker -Q video_upscale -n video-upscale@%%h --concurrency=4 --loglevel=INFO
Restart=always
RestartSec=3
TimeoutStopSec=14400
KillSignal=SIGTERM
LimitNOFILE=65536
TasksMax=512

[Install]
WantedBy=default.target

[Unit]
Description=AI Centre DA2/DA3 Video Depth Celery Worker
After=network-online.target ai-centre-redis.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/donxu/ai-centre
EnvironmentFile=/home/donxu/ai-centre/.env
Environment=PYTHONPATH=/home/donxu/ai-centre
Environment=CUDA_VISIBLE_DEVICES=1
ExecStart=/home/donxu/ai-centre/.venv-depth/bin/celery -A control_plane.celery_app:celery_app worker -Q video_depth -n depth@%%h --pool=threads --concurrency=2 --prefetch-multiplier=1 --loglevel=INFO
Restart=always
RestartSec=5
TimeoutStartSec=900
TimeoutStopSec=7200
KillSignal=SIGTERM
LimitNOFILE=65536
TasksMax=1024

[Install]
WantedBy=default.target

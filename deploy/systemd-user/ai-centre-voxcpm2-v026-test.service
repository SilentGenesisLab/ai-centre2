[Unit]
Description=AI Centre VoxCPM2 vLLM-Omni v0.26.0 validation backend on GPU 1
After=network-online.target
Wants=network-online.target
Conflicts=ai-centre-voxcpm2-gpu1.service

[Service]
Type=simple
WorkingDirectory=/home/donxu/ai-centre
Environment=CUDA_VISIBLE_DEVICES=1
Environment=CUDA_HOME=/home/donxu/ai-centre/.venv-tts-v026/lib/python3.12/site-packages/nvidia/cu13
Environment=PATH=/home/donxu/ai-centre/.venv-tts-v026/lib/python3.12/site-packages/nvidia/cu13/bin:/home/donxu/ai-centre/.venv-tts-v026/bin:/usr/local/bin:/usr/bin:/bin
Environment=HF_HOME=/home/donxu/ai-centre/models/.cache/huggingface
Environment=VLLM_CACHE_ROOT=/home/donxu/ai-centre/runtime/vllm-v026
Environment=VLLM_USE_FLASHINFER_SAMPLER=0
Environment=SPEAKER_SAMPLES_DIR=/home/donxu/ai-centre/runtime/control/tts-speakers
ExecStart=/home/donxu/ai-centre/.venv-tts-v026/bin/vllm serve /home/donxu/ai-centre/models/VoxCPM2 --omni --host 127.0.0.1 --port 8194 --allowed-local-media-path /home/donxu/ai-centre/runtime/references --deploy-config /home/donxu/ai-centre/deploy/voxcpm2-v026.yaml
Restart=no
TimeoutStartSec=900
TimeoutStopSec=180
KillSignal=SIGTERM
LimitNOFILE=1048576
TasksMax=4096

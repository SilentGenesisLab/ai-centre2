[Unit]
Description=AI Centre decision (Jev / TypeSafe typed decision) generation worker
After=network-online.target redis.service

[Service]
Type=simple
WorkingDirectory=/home/donxu/ai-centre
EnvironmentFile=/home/donxu/ai-centre/.env
ExecStart=/home/donxu/ai-centre/.venv-control/bin/celery -A control_plane.celery_app:celery_app worker -Q decision_generation -n decision-generation@%%h --concurrency=8 --loglevel=INFO
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
